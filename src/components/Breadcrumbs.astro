---
import BackLink from './BackLink.astro';
import { SITE } from '@/lib/site';
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const all = [{ name: 'Inicio', href: '/' }, ...items];
const parent = all[all.length - 2];
const backLabel =
  parent.href === '/productos'
    ? 'Volver al catálogo'
    : parent.href === '/'
      ? 'Volver al inicio'
      : `Volver a ${parent.name}`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.name,
    item: new URL(it.href, SITE.url).href,
  })),
};
---

<nav aria-label="Migas de pan">
  <BackLink href={parent.href} label={backLabel} />
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
