---
import CartButton from './CartButton';
import { DELIVERY_PRICES } from '@/lib/delivery';
import { formatPrice } from '@/lib/format';

const path = Astro.url.pathname;
const nav = [
  {
    label: 'Catálogo',
    href: '/productos',
    current: path.startsWith('/productos') || path.startsWith('/categoria'),
  },
  {
    label: 'Preguntas',
    href: '/como-comprar',
    current: path.startsWith('/como-comprar'),
  },
  {
    label: 'Contacto',
    href: '/#asesoramiento',
    current: false,
  },
];
---

<div class="announcement-bar bg-ink text-sm text-stone-200">
  <a href="/como-comprar#envios" class="container-page flex min-h-11 flex-wrap items-center justify-center gap-x-4 gap-y-1 py-3 text-center focus-visible:outline-2 focus-visible:outline-brand-500">
    <span class="inline-flex items-center justify-center gap-2 font-semibold text-white">
      <svg class="shrink-0 text-brand-300" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 18V6H2v12h3m4 0h6m-1-10h4l4 5v5h-3"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
      <span>Envío a domicilio en CABA por <strong class="whitespace-nowrap text-brand-300">{formatPrice(DELIVERY_PRICES.caba)}</strong></span>
    </span>
    <span>AMBA hasta 5 km: <strong class="whitespace-nowrap text-brand-300">{formatPrice(DELIVERY_PRICES.nearby)}</strong> · <span class="whitespace-nowrap">Resto: <strong class="text-brand-300">{formatPrice(DELIVERY_PRICES.amba)}</strong> <span aria-hidden="true">→</span></span></span>
  </a>
</div>
<header class="site-header sticky top-[env(safe-area-inset-top,0px)] z-30 border-b border-stone-200 bg-white">
  <div class="container-page flex h-14 items-center justify-between gap-3 lg:h-16">
    <a href="/" class="flex shrink-0 items-center" aria-label="Ferralto, inicio">
      <img src="/logo.png" alt="Ferralto" width="980" height="237" class="h-auto w-32 sm:w-40 lg:w-44" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-semibold tracking-[-0.011em] hover:text-brand-700',
            item.current ? 'text-brand-700' : 'text-steel',
          ]}
          aria-current={item.current ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <CartButton client:load />
      <details class="nav-sheet lg:hidden">
        <summary class="nav-toggle">
          <span class="sr-only nav-label-open">Abrir menú</span>
          <span class="sr-only nav-label-close">Cerrar menú</span>
          <svg class="nav-icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="nav-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <nav class="nav-panel" aria-label="Menú móvil">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  const sheet = document.querySelector<HTMLDetailsElement>('.nav-sheet');
  const header = document.querySelector<HTMLElement>('.site-header');
  if (sheet && header) {
    const place = () => {
      const bottom = Math.max(0, Math.round(header.getBoundingClientRect().bottom));
      document.documentElement.style.setProperty('--chrome-bottom', `${bottom}px`);
    };
    sheet.addEventListener('toggle', () => {
      place();
      document.documentElement.classList.toggle('nav-open', sheet.open);
    });
    sheet.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        sheet.open = false;
        document.documentElement.classList.remove('nav-open');
      });
    });
    addEventListener('resize', place);
    addEventListener('scroll', () => {
      if (sheet.open) place();
    }, { passive: true });
  }
</script>
