---
import BackLink from '@/components/BackLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LADDER_DELIVERY_TIME } from '@/lib/delivery';
import { SITE } from '@/lib/site';
import { whatsappContactUrl } from '@/lib/whatsapp';
const faqs = [
  {
    q: '¿Cómo compro?',
    a: 'Agregá los productos al carrito, completá tus datos y pagá con Mercado Pago. Si preferís, podés enviarnos el pedido por WhatsApp y lo coordinamos.',
  },
  {
    q: '¿Cómo funcionan los envíos y retiros?',
    a: `Hacemos envíos a domicilio dentro de AMBA. El costo depende de la dirección y de los productos y cantidades del pedido. Ingresá calle y número, localidad y código postal para conocer el importe antes de pagar. Si tu dirección o tu pedido necesitan confirmación, consultanos por WhatsApp. Coordinamos la fecha de entrega por ese medio. ${SITE.pickupLabel}.`,
  },
  {
    q: '¿Cuánto tarda la entrega de una escalera?',
    a: LADDER_DELIVERY_TIME,
  },
  {
    q: '¿Qué medios de pago aceptan?',
    a: 'Tarjetas de crédito y débito (con cuotas), dinero en cuenta de Mercado Pago, transferencia y efectivo en puntos de pago.',
  },
  {
    q: '¿Tienen garantía los productos?',
    a: 'Todos nuestros productos tienen garantía por defectos de fabricación. Escribinos por WhatsApp ante cualquier problema.',
  },
];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Cómo comprar, envíos y pagos"
  description={`Cómo comprar en Ferralto: envíos dentro de AMBA, medios de pago y garantía. ${SITE.pickupLabel}.`}
  jsonLd={ld}
>
  <div class="container-page max-w-3xl py-12">
    <BackLink href="/productos" label="Volver al catálogo" />
    <h1 class="page-title mt-2">Cómo comprar</h1>
    <div class="mt-8 space-y-4">
      {faqs.map((f, i) => (
        <details
          id={['comprar', 'envios', 'plazos', 'pagos', 'garantia'][i]}
          class="rounded-xl border border-stone-200 bg-white p-5"
          open={i === 0 || i === 1}
        >
          <summary class="cursor-pointer font-semibold">{f.q}</summary>
          <p class="mt-3 text-steel">{f.a}</p>
          {i === 1 && (
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 font-semibold underline">
              <a href="/calcular-envio">Calculá tu envío →</a>
              <a href={whatsappContactUrl('¡Hola Ferralto! Quiero coordinar un retiro.')} target="_blank" rel="noopener">
                Coordiná el retiro por WhatsApp ↗
              </a>
            </div>
          )}
        </details>
      ))}
    </div>
  </div>
</BaseLayout>
