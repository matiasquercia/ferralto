---
import BuyingAnswers from '@/components/BuyingAnswers.astro';
import HeroSlides from '@/components/HeroSlides.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { categories, getFeaturedProducts, getProductsByCategory } from '@/lib/catalog';
import { SITE } from '@/lib/site';
import { productImage } from '@/lib/images';
import { whatsappContactUrl } from '@/lib/whatsapp';

const featured = getFeaturedProducts();
const categoryImage = (slug: string, size = 640) => productImage(getProductsByCategory(slug)[0]?.images[0] ?? '', size);
const [leadCategory, ...otherCategories] = categories;
const productCount = (slug: string) => {
  const count = getProductsByCategory(slug).length;
  return count === 1 ? '1 producto' : `${count} productos`;
};
const icon =
  'width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const whatsappLogo =
  '<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>';
const benefits = [
  {
    title: 'Envío en CABA por $15.000',
    text: 'AMBA hasta 5 km: $15.000. Resto: $35.000 por pedido.',
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>`,
  },
  {
    title: 'Pagá en cuotas',
    text: 'Mercado Pago, tarjetas de crédito, débito o transferencia.',
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/><path d="M6 15h4"/></svg>`,
  },
  {
    title: 'Atención por WhatsApp',
    text: 'Te asesoramos antes y después de tu compra.',
    tone: 'bg-[#25D366]/10 text-[#25D366] ring-[#25D366]/20',
    svg: whatsappLogo,
    href: whatsappContactUrl('¡Hola! Quiero hacer una consulta.'),
  },
  {
    title: 'Fabricación nacional',
    text: 'Acero con tratamiento anticorrosivo y pintura epoxi.',
    tone: 'bg-brand-50 text-brand-700 ring-brand-100',
    svg: `<svg ${icon}><path d="M3 21V9.5a.5.5 0 0 1 .77-.42L9 12.5V9.5a.5.5 0 0 1 .77-.42L15 12.5V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v17"/><path d="M2 21h20"/><path d="M7 17h2M12 17h2M17 17h2"/></svg>`,
  },
];
---

<BaseLayout jsonLd={{ "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: SITE.url, inLanguage: "es-AR" }}>
  <section class="home-hero hero-photo" data-hero aria-labelledby="hero-title">
    <HeroSlides />
    <div class="container-page hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">
          <span></span> FERRETERÍA · HOGAR · PROYECTOS
        </p>
        <h1 id="hero-title">
          <span>Equipá tu casa.</span>
          <span>Hacé más.</span>
        </h1>
        <p class="hero-description">
          Escaleras, tenders y soluciones para tu hogar. Elegí el modelo que necesitás, comprá online y
          recibilo en tu casa.
        </p>
        <div class="hero-actions">
          <a href="/productos" class="btn-primary">
            Explorá el catálogo <span aria-hidden="true">↗</span>
          </a>
          <a
            href={whatsappContactUrl('¡Hola! Necesito asesoramiento para elegir un producto.')}
            class="hero-advice"
            target="_blank"
            rel="noopener"
          >
            Te asesoramos por WhatsApp <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-facts">
          <span>CABA: envío a domicilio por $15.000</span>
          <span>Pagá con Mercado Pago</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-benefits" aria-labelledby="benefits-title">
    <div class="container-page">
      <h2 id="benefits-title" class="sr-only">
        Por qué comprar en Ferralto
      </h2>
      <ul>
        {benefits.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                {...(b.href && { href: b.href, target: '_blank', rel: 'noopener' })}
                class:list={['home-benefit', b.href && 'benefit-link']}
              >
                <span class="home-benefit-head">
                  <span class="home-benefit-icon" set:html={b.svg} />
                  <h3>{b.title}</h3>
                  {b.href && (
                    <svg class="home-benefit-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                      <path d="M6 3.5 10.5 8 6 12.5" />
                    </svg>
                  )}
                </span>
                <p>{b.text}</p>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="home-categories" aria-labelledby="cat-title">
    <div class="container-page">
      <header class="home-section-head">
        <p>Catálogo</p>
        <h2 id="cat-title">¿Qué necesitás para tu casa?</h2>
      </header>
      <div class="home-category-layout">
        <a href={`/categoria/${leadCategory.slug}`} class="home-cat home-cat-lead category-card">
          <img
            src={categoryImage(leadCategory.slug, 960)}
            alt={leadCategory.name}
            width="960"
            height="960"
            loading="lazy"
            decoding="async"
          />
          <span class="home-cat-label">
            <strong>{leadCategory.name}</strong>
            <em>{productCount(leadCategory.slug)}</em>
          </span>
        </a>
        {otherCategories.map((c) => (
          <a href={`/categoria/${c.slug}`} class="home-cat category-card">
            <img
              src={categoryImage(c.slug)}
              alt={c.name}
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
            <span class="home-cat-label">
              <strong>{c.name}</strong>
              <em>{productCount(c.slug)}</em>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-sheet" aria-labelledby="feat-title">
    <div class="container-page">
      <header class="home-section-head">
        <p>Destacados</p>
        <div class="home-section-row">
          <h2 id="feat-title">Elegidos del catálogo</h2>
          <a href="/productos/todos">Ver todos</a>
        </div>
      </header>
      <div class="catalog-grid">
        {featured.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>
  <section class="home-close" id="asesoramiento" aria-labelledby="advice-title">
    <div class="container-page">
    <div class="home-advice">
      <div>
        <p class="eyebrow">COMPRÁ CON ASESORAMIENTO</p>
        <h2 id="advice-title">
          El producto indicado.
          <br />
          Desde la primera consulta.
        </h2>
        <p>Consultanos por medidas, modelos y disponibilidad antes de elegir.</p>
      </div>
      <a
        href={whatsappContactUrl('¡Hola! Quiero que me ayuden a elegir un producto.')}
        target="_blank"
        rel="noopener"
        class="btn-primary"
      >
        Hablá con nosotros ↗
      </a>
    </div>
    <ol class="purchase-steps">
      <li>
        <span class="purchase-mark">1</span>
        <h3>Elegí tu producto</h3>
        <p>Revisá las medidas y los colores en cada ficha.</p>
      </li>
      <li>
        <span class="purchase-mark">2</span>
        <h3>Armá tu pedido</h3>
        <p>Sumalo al carrito o consultanos por WhatsApp.</p>
      </li>
      <li>
        <span class="purchase-mark">3</span>
        <h3>Coordiná la entrega</h3>
        <p>
          <a href="/como-comprar#envios">Conocé cómo funcionan los envíos →</a>
        </p>
      </li>
    </ol>
    </div>
  </section>
  <BuyingAnswers />
  <script>
    const section = document.getElementById('asesoramiento');
    const place = () => {
      if (!section || location.hash !== '#asesoramiento') return;
      const root = document.documentElement;
      const previous = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      section.scrollIntoView();
      root.style.scrollBehavior = previous;
    };
    place();
    addEventListener('load', place);
    addEventListener('hashchange', place);
  </script>
</BaseLayout>
